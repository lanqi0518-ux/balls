# Copy to `.env` and fill in.

RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

REGISTRY_ADDRESS=0x...           # IPORegistry deployment
KEEPER_PRIVATE_KEY=0x...         # authorized keeper EOA
POLL_INTERVAL_MS=30000           # how often to poll /rhj/assets

# Optional Slack/Discord webhook for launch notifications
WEBHOOK_URL=
