# ================================
# Balls Lottery Backend Config
# ================================

RPC_URL=https://rpc.mainnet.chain.robinhood.com
TOKEN_ADDRESS=0x_YOUR_TOKEN_ADDRESS

# Prize pool wallet — receives the 3% lottery tax
# 100% of this wallet (minus 0.05 ETH gas) is paid to winners
TAX_RECEIVER_WALLET=0xfaF2deaF29C4A0bb086195c675eA37d4820E0598
TAX_RECEIVER_PRIVATE_KEY=your_private_key_here

# Publisher auto 1% wallet (only if different from the prize pool wallet)
# At each draw with winners, this balance (minus 0.05 ETH gas) is forwarded
# to TEAM_WALLET in the same batch as prize payouts
PUBLISHER_WALLET=
PUBLISHER_PRIVATE_KEY=

# Team wallet that receives the forwarded publisher 1%
TEAM_WALLET=0x9bae8aDF73F0dd6d27acB12E41eb9B800f93785F

PORT=3001

# ================================
# Draw schedule
# ================================

# Time between draws, in ms. Default is sized so a fresh buyer arriving
# right after a draw has exactly MIN_HOLDING_DURATION (60s) to clear the
# holding requirement before the next snapshot: 10s snapshot lead + 60s
# buyer window = 70s per draw. Set to 60000 for one-minute draws if you
# accept that new buyers wait an extra round.
DRAW_INTERVAL=70000

# How long before a draw the participant list is frozen, in ms.
# Must be shorter than DRAW_INTERVAL.
SNAPSHOT_LEAD_TIME=10000

# How long an address must hold before it can win, in seconds.
# Anything longer than DRAW_INTERVAL - SNAPSHOT_LEAD_TIME still works, but a
# new buyer then has to sit out a round before becoming eligible.
MIN_HOLDING_DURATION=60

# How many holders, ranked by balance, take part in a draw
TOP_HOLDERS_LIMIT=100

# Set to false to stop the scheduler without stopping the server
AUTO_DRAW_ENABLED=true

# ================================
# Access control
# ================================

# Required by POST /api/tracker/exclude, POST /api/tracker/rescan and
# GET /api/admin/verify-config, sent as "Authorization: Bearer <token>".
# Leaving it unset disables those endpoints rather than leaving them open.
ADMIN_TOKEN=

# Comma-separated browser origins allowed to call the API.
# Empty means any origin.
ALLOWED_ORIGINS=
