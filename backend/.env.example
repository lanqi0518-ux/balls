# ================================
# Balls Lottery Backend Config
# ================================

# Blockchain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Token contract address (fill after launching on Pons)
TOKEN_ADDRESS=0x_YOUR_TOKEN_ADDRESS

# Tax receiver wallet (receives 4% tax from Pons)
TAX_RECEIVER_WALLET=0xfaF2deaF29C4A0bb086195c675eA37d4820E0598

# Tax receiver wallet private key (for auto transfer)
# This wallet will:
# 1. Send 1% to dev wallet before each draw
# 2. Send remaining 3% to winners
TAX_RECEIVER_PRIVATE_KEY=your_private_key_here

# Server port
PORT=3001
