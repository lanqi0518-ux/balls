# ================================
# Powerball Lottery 后端配置
# ================================

# 区块链 RPC
RPC_URL=https://rpc.robinhoodchain.com

# 代币合约地址（在 Pons 发币后填写）
TOKEN_ADDRESS=0x你的代币合约地址

# 奖池钱包私钥（用于自动转账给中奖者）
# ⚠️ 重要：这是创作者钱包的私钥！
# 不配置 = 只记录中奖，不自动转账
# 配置后 = 开奖后自动转账给中奖者
PRIZE_POOL_PRIVATE_KEY=你的奖池钱包私钥

# 服务端口
PORT=3001
